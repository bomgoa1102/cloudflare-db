{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"name": "cloudflare-d1-login-demo",
	"main": "src/index.js",
	"compatibility_date": "2026-11-21",
	"assets": {
		"directory": "./public",
		"binding": "ASSETS"
	},
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "login-demo-db",
			"database_id": "2db3013c-2003-44fa-9f8c-d39495e0f891",
			"migrations_dir": "migrations"
		},
		{
			"binding": "login_demo_db",
			"database_name": "login-demo-db",
			"database_id": "2db3013c-2003-44fa-9f8c-d39495e0f891"
		}
	]
}